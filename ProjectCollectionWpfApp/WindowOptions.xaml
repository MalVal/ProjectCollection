<Window x:Class="ProjectCollectionWpfApp.WindowOptions"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:ProjectCollectionWpfApp"
        mc:Ignorable="d"
        Title="WindowOptions" Height="200"  Width="400">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Label Content="Color : " Grid.Row="0" Grid.Column="0"></Label>
        <xctk:ColorPicker x:Name="colorPicker" DisplayColorAndName="True" SelectedColorChanged="ColorPicker_SelectedColorChanged" Grid.Row="0" Grid.Column="1"/>

        <Label Content="{Binding ComicsPathL}" Grid.Row="1" Grid.Column="0"/>
        <Button x:Name="ComicsPath" Content="Change path" Grid.Row="1" Grid.Column="1" Click="ComicsPath_Click"/>

        <Label Content="{Binding VinylPathL}" Grid.Row="2" Grid.Column="0"/>
        <Button x:Name="VinylPath" Content="Change path" Grid.Row="2" Grid.Column="1" Click="VinylPath_Click"/>

    </Grid>
</Window>
