<Window x:Class="ProjectCollectionWpfApp.WindowCreateElement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectCollectionWpfApp"
        mc:Ignorable="d"
        Title="WindowCreateElement" Height="450" Width="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="9*"/>
        </Grid.RowDefinitions>
        
        <ComboBox x:Name="comboBox" SelectionChanged="comboBox_SelectionChanged" Grid.Row="0">
            <ComboBoxItem Content="Comics"/>
            <ComboBoxItem Content="Vinyls"/>
        </ComboBox>

        <Grid Grid.Row="1" x:Name="GridAdd">

            <Grid.RowDefinitions>
                <RowDefinition Height="4*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Background="BurlyWood" x:Name="SPcomics" Visibility="Hidden">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Name :" Grid.Column="0"></Label>
                    <TextBox x:Name="ComName" Grid.Column="1"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Price :" Grid.Column="0"></Label>
                    <TextBox x:Name="ComPrice" Grid.Column="1"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Date (YYYY-MM-DD) :" Grid.Column="0"></Label>
                    <DatePicker x:Name="ComDate" Grid.Column="1"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Isbn :" Grid.Column="0"></Label>
                    <TextBox x:Name="ComIsbn" Grid.Column="1"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Autor :" Grid.Column="0"></Label>
                    <TextBox x:Name="ComAutor" Grid.Column="1"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Topic :" Grid.Column="0"></Label>
                    <TextBox x:Name="ComTopic" Grid.Column="1"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Image x:Name="ComImage" Width="100" Height="100"/>
                    <Button x:Name="BtnImageComics" Content="Importer image" Grid.Column="1" Click="BtnImageComics_Click"/>
                </Grid>

                <Label x:Name="ComError" Content=""></Label>

            </StackPanel>

            <StackPanel Grid.Row="0" Background="Aquamarine" x:Name="SPvinyls" Visibility="Hidden">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Name :" Grid.Column="0"></Label>
                    <TextBox x:Name="VinName" Grid.Column="1"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Price :" Grid.Column="0"></Label>
                    <TextBox x:Name="VinPrice" Grid.Column="1"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Date (YYYY-MM-DD) :" Grid.Column="0"></Label>
                    <DatePicker x:Name="VinDate" Grid.Column="1"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Genre :" Grid.Column="0"></Label>
                    <TextBox x:Name="VinGenre" Grid.Column="1"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Label :" Grid.Column="0"></Label>
                    <TextBox x:Name="VinLabel" Grid.Column="1"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Country :" Grid.Column="0"></Label>
                    <TextBox x:Name="VinCountry" Grid.Column="1"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Composer :" Grid.Column="0"></Label>
                    <TextBox x:Name="VinComposer" Grid.Column="1"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Image x:Name="VinImage" Width="100" Height="100"/>
                    <Button x:Name="BtnImageVinyl" Content="Importer image" Grid.Column="1" Click="BtnImageVinyl_Click"/>
                </Grid>

                <Label x:Name="VinError" Content=""></Label>

            </StackPanel>

            <Button x:Name="BtnCreateComics" Content="Create comics" Grid.Row="1" Click="BtnCreateComics_Click" Visibility="Hidden"/>
            <Button x:Name="BtnCreateVinyl" Content="Create vinyl" Grid.Row="1" Click="BtnCreateVinyl_Click" Visibility="Hidden"/>

        </Grid>
        
    </Grid>
    
</Window>
