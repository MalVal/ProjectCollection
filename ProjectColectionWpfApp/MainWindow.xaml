<Window x:Class="ProjectColectionWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectColectionWpfApp"
        mc:Ignorable="d"
        Title="ProjectCollection" MinHeight="550" MinWidth="850">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="8*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">

            <StackPanel Background="DeepPink">
                <Label Content="Search by name :"></Label>
                <TextBox/>
                <Button Content="Search"/>

                <Label Content="Order by :"></Label>
                <RadioButton Content="Name ascending" GroupName="Order"/>
                <RadioButton Content="Name descending" GroupName="Order"/>
                <RadioButton Content="Price ascending" GroupName="Order"/>
                <RadioButton Content="Price descending" GroupName="Order"/>
                <RadioButton Content="Date added ascending" GroupName="Order"/>
                <RadioButton Content="Date added descending" GroupName="Order"/>

                <Label Content="Type :"></Label>
                <CheckBox Content="Vinyls"/>
                <CheckBox Content="Comics"/>

            </StackPanel>

        </ScrollViewer>

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="0" Background="BurlyWood">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Name :" Grid.Column="0"></Label>
                        <TextBox x:Name="ComName" Grid.Column="1"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Price :" Grid.Column="0"></Label>
                        <TextBox x:Name="ComPrice" Grid.Column="1"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Date (YYYY-MM-DD) :" Grid.Column="0"></Label>
                        <TextBox x:Name="ComDate" Grid.Column="1"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Isbn :" Grid.Column="0"></Label>
                        <TextBox x:Name="ComIsbn" Grid.Column="1"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Autor :" Grid.Column="0"></Label>
                        <TextBox x:Name="ComAutor" Grid.Column="1"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Topic :" Grid.Column="0"></Label>
                        <TextBox x:Name="ComTopic" Grid.Column="1"/>
                    </Grid>

                    <Label x:Name="ComError" Content=""></Label>

                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="0" Background="Aquamarine">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Name :" Grid.Column="0"></Label>
                        <TextBox x:Name="VinName" Grid.Column="1"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Price :" Grid.Column="0"></Label>
                        <TextBox x:Name="VinPrice" Grid.Column="1"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Date (YYYY-MM-DD) :" Grid.Column="0"></Label>
                        <TextBox x:Name="VinDate" Grid.Column="1"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Genre :" Grid.Column="0"></Label>
                        <TextBox x:Name="VinGenre" Grid.Column="1"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Label :" Grid.Column="0"></Label>
                        <TextBox x:Name="VinLabel" Grid.Column="1"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Country :" Grid.Column="0"></Label>
                        <TextBox x:Name="VinCountry" Grid.Column="1"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Composer :" Grid.Column="0"></Label>
                        <TextBox x:Name="VinComposer" Grid.Column="1"/>
                    </Grid>

                    <Label x:Name="VinError" Content=""></Label>

                </StackPanel>

                <Button x:Name="BtnCreateComics" Content="Create comics" Grid.Column="0" Grid.Row="1" Click="BtnCreateComics_Click"/>
                <Button x:Name="BtnCreateVinyl" Content="Create vinyl" Grid.Column="1" Grid.Row="1" Click="BtnCreateVinyl_Click"/>

            </Grid>

        </Grid>

    </Grid>

</Window>
