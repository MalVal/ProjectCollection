<Window x:Class="ProjectColectionWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectColectionWpfApp"
        mc:Ignorable="d"
        Title="ProjectCollection" Height="450" Width="800">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="9*"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1">

            <Grid Grid.Row="0">

                

            </Grid>

        </Border>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="8*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1">

                <StackPanel>
                    <Label Content="Search by name :"></Label>
                    <TextBox/>
                    <Button Content="Search"/>

                    <Label Content="Order by :"></Label>
                    <RadioButton Content="Name ascending" GroupName="Order"/>
                    <RadioButton Content="Name descending" GroupName="Order"/>
                    <RadioButton Content="Price ascending" GroupName="Order"/>
                    <RadioButton Content="Price descending" GroupName="Order"/>
                    <RadioButton Content="Date added ascending" GroupName="Order"/>
                    <RadioButton Content="Date added descending" GroupName="Order"/>

                    <Label Content="Type :"></Label>
                    <CheckBox Content="Vinyls"/>
                    <CheckBox Content="Comics"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>
