<Window x:Class="ProjectColectionWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectColectionWpfApp"
        mc:Ignorable="d"
        Title="ProjectCollection" MinHeight="600" MinWidth="1000" Closing="Window_Closing">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="8*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">

            <StackPanel Background="DeepPink">
                <Label Content="Search by name :"></Label>
                <TextBox/>
                <Button Content="Search"/>

                <Label Content="Order by :"></Label>
                <RadioButton Content="Name ascending" GroupName="Order"/>
                <RadioButton Content="Name descending" GroupName="Order"/>
                <RadioButton Content="Price ascending" GroupName="Order"/>
                <RadioButton Content="Price descending" GroupName="Order"/>
                <RadioButton Content="Date added ascending" GroupName="Order"/>
                <RadioButton Content="Date added descending" GroupName="Order"/>

                <Label Content="Type :"></Label>
                <RadioButton Content="Vinyls" GroupName="Element" Checked="RadioButtonElement_Checked"/>
                <RadioButton Content="Comics" GroupName="Element" Checked="RadioButtonElement_Checked"/>

            </StackPanel>

        </ScrollViewer>

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="8*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="dataGrid" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="True" AutoGenerateColumns="True" Grid.Row="0"/>

            <Grid Grid.Row="1">

                <Button x:Name="BtnCreateElement" Content="Create elements" Grid.Column="0" Grid.Row="1" Click="BtnCreateElement_Click"/>

            </Grid>

        </Grid>

    </Grid>

</Window>
